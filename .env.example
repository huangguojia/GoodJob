CRM_STORE=mysql
APP_DATABASE_PROFILE=production
CRM_SEED_DEVELOPMENT_DATA=false
AGENT_SKILLS_DIR=./agent-skills
DATABASE_URL=mysql://goodjob:change_me@127.0.0.1:3306/goodjob_crm
PORT=4188
BACKEND_HOST=127.0.0.1
JWT_SECRET=replace_with_at_least_32_random_characters
PLATFORM_MFA_ENCRYPTION_KEY=replace_with_a_separate_32_plus_character_random_key
PROVIDER_CREDENTIAL_KEY=replace_with_a_separate_32_plus_character_random_key
# 邮箱授权码也使用 PROVIDER_CREDENTIAL_KEY 派生密钥加密；上线后不得更换或丢失该密钥。
MYSQL_DATA_IMPORT_TOKEN=replace_with_a_distinct_32_plus_character_random_key
# MySQL 集成测试必须使用独立管理连接，禁止回退到业务数据库连接。
MYSQL_TEST_ADMIN_URL=mysql://test_admin:change_me@127.0.0.1:3306/mysql
MYSQL_TEST_APP_URL=mysql://test_app:change_me@127.0.0.1:3306/
# 是否允许将数据库备份写入服务器本地磁盘。空间有限的服务器保持 false。
MYSQL_LOCAL_BACKUP_ENABLED=false
# 仅在开启本地备份时使用；相对路径按后端运行目录解析。
MYSQL_LOCAL_BACKUP_DIR=../backups/database
# 自动删除超过指定天数的备份；0 表示不自动清理。
MYSQL_LOCAL_BACKUP_RETENTION_DAYS=7
AGENT_JOB_ENCRYPTION_KEY=replace_with_a_distinct_32_plus_character_random_key
TRADE_OBSERVATION_CURSOR_SECRET=replace_with_another_32_plus_character_random_key
MARKET_OPPORTUNITY_CURSOR_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_RUN_IDEMPOTENCY_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_RUN_CURSOR_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_EXECUTION_CLAIM_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_WORKER_ENABLED=true
PROSPECT_WORKER_POLL_MS=1000
PROSPECT_WORKER_CONCURRENCY=3
AI_SEARCH_TIMEOUT_MS=75000
PROSPECT_SUPER_SEARCH_AI_PLANNING_TIMEOUT_MS=20000
# 仅明确标记为中国以外且非中国域名的候选，按 robots 规则低频读取首页和最多一个同域联系页；中国及国家不明候选硬阻断。
WEBSITE_PROBE_ENABLED=true
WEBSITE_PROBE_AUTO_ENRICH=true
WEBSITE_PROBE_AUTO_MAX_PER_CYCLE=4
WEBSITE_PROBE_TEAM_INTERVAL_MS=3000
WEBSITE_PROBE_TIMEOUT_MS=18000
WEBSITE_PROBE_MAX_RESPONSE_BYTES=262144
AUTO_WEBSITE_PROBE_ENABLED=true
AUTO_WEBSITE_PROBE_LIMIT=12
# 当前超级搜索轮次超过此时间无运行、分片、请求或 Worker 心跳更新时自动收口。
PROSPECT_SUPER_SEARCH_STALL_MS=900000
PROSPECT_EXECUTION_DB_LOCK_TIMEOUT_MS=5000
PROSPECT_CANDIDATE_DB_LOCK_TIMEOUT_MS=5000
REDIS_URL=
PROSPECT_QUEUE_REQUIRED=false
PROSPECT_QUEUE_SYNC_MS=5000
PROSPECT_REDIS_CONNECT_TIMEOUT_MS=3000
# 外部工具集成默认关闭；启用后 API 与 Integration Worker 必须共用以下配置。
INTEGRATION_ENABLED=false
INTEGRATION_WORKER_ENABLED=false
INTEGRATION_CREDENTIAL_KEY=replace_with_a_distinct_32_plus_character_random_key
INTEGRATION_OAUTH_CALLBACK_BASE_URL=https://crm.example.com
# Microsoft Graph Webhook 必须指向同一公网 HTTPS 地址；留空时回退到 OAuth 回调地址
INTEGRATION_WEBHOOK_BASE_URL=https://crm.example.com
INTEGRATION_OAUTH_SUCCESS_REDIRECT_URL=https://crm.example.com/
# Microsoft 365：Client ID 为必填，Tenant ID 可填 organizations、common、consumers 或租户 GUID。
INTEGRATION_MICROSOFT_CLIENT_ID=
INTEGRATION_MICROSOFT_TENANT_ID=organizations
# 生产环境建议使用 Azure 应用的客户端密钥；仅通过服务器环境注入，不写入数据库或前端。
INTEGRATION_OAUTH_MICROSOFT_CLIENT_SECRET=
# Google Workspace：在 Google Cloud OAuth Web 应用中配置回调 /api/integrations/oauth/callback/google-workspace。
INTEGRATION_GOOGLE_CLIENT_ID=
# 只通过服务器环境注入，不写入数据库、前端或连接器表。
INTEGRATION_OAUTH_GOOGLE_CLIENT_SECRET=
# ERPNext 实例根地址，生产环境必须是固定 HTTPS；API Key/Secret 由管理员在集成中心按连接填写。
INTEGRATION_ERPNEXT_BASE_URL=
ORGANIZATION_IDENTITY_MASTER_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_SOURCE_RAW_ENVELOPE_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_COVERAGE_MASTER_SECRET=replace_with_a_distinct_32_plus_character_random_key
# 以下三项只用于生产空库首次启动；部署成功后应从运行环境中删除。
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_12_plus_character_password
INITIAL_ADMIN_NAME=Super Admin
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5188,http://localhost:5188
ENABLE_API_DOCS=true
# 开发信回流。生产环境追踪地址必须是 CRM 的公网 HTTPS 根地址。
INBOUND_MAIL_ENABLED=true
INBOUND_MAIL_POLL_MS=120000
INBOUND_MAIL_LOOKBACK_DAYS=7
INBOUND_MAIL_MAX_MESSAGES_PER_POLL=100
INBOUND_MAIL_MAX_SOURCE_BYTES=2097152
EMAIL_TRACKING_BASE_URL=https://crm.example.com
EMAIL_TRACKING_SECRET=replace_with_a_distinct_32_plus_character_random_key
EMAIL_MESSAGE_ID_DOMAIN=crm.example.com
# 邮箱信誉保护：每个业务员邮箱单独计数。
OUTBOUND_EMAIL_DAILY_LIMIT=50
OUTBOUND_EMAIL_DOMAIN_WINDOW_MINUTES=10
OUTBOUND_EMAIL_DOMAIN_WINDOW_LIMIT=5
OUTBOUND_EMAIL_BOUNCE_WINDOW_DAYS=7
OUTBOUND_EMAIL_BOUNCE_MIN_SAMPLE=20
OUTBOUND_EMAIL_MAX_BOUNCE_PERCENT=10
OUTBOUND_EMAIL_APPEND_OPTOUT=true
# true 时发送前强制要求 SPF、DMARC；配置 EMAIL_DKIM_SELECTORS 后也会强制检查 DKIM。
OUTBOUND_EMAIL_REQUIRE_DNS_AUTH=false
EMAIL_DKIM_SELECTORS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=
# 非官方 WhatsApp Web 协议只允许在非生产环境显式开启。
WHATSAPP_ENABLE_WEB_SCAN=false
# Communication 服务生产构建只允许 Meta 官方 Cloud API。
WHATSAPP_OFFICIAL_ONLY=true
