# Development is the server default. Set NODE_ENV=production only in the production runtime.
# NODE_ENV=production
# Production must keep this true. Development and test default to false.
# WHATSAPP_OFFICIAL_ONLY=true
HOST=127.0.0.1
PORT=3100
WEB_ORIGIN=http://127.0.0.1:5173

# Must match the CRM backend JWT_SECRET. Plugin APIs and realtime sockets reject
# requests without a valid signed CRM session.
CRM_JWT_SECRET=

# Local development defaults to embedded PGlite. Production shares the CRM MySQL database.
DATABASE_CLIENT=pglite
PGLITE_PATH=.data/pgdata
MEDIA_STORAGE_PATH=.data/media
# DATABASE_CLIENT=mysql
# DATABASE_URL=mysql://user:password@localhost:3306/goodjob_crm

# In production this must be a base64-encoded 32-byte key.
# Development creates a gitignored key under .data when this is empty.
SESSION_MASTER_KEY=

# Demo records and the simulated transport are opt-in, even in development.
# Never enable either setting in a production runtime.
SEED_DEMO=false
ALLOW_DEMO_PROVIDER=false
# Development convenience only. Production requires false and a separate `npm run db:migrate` release step.
AUTO_MIGRATE=true
ALLOW_PRIVATE_AI_ENDPOINTS=false

# Optional HTTP(S) CONNECT proxy used only by Baileys WhatsApp traffic.
# BAILEYS_PROXY_URL=http://127.0.0.1:7897

# Optional HTTP(S) proxy for Meta Graph / media CDN traffic only. Node's built-in fetch does not
# read HTTP(S)_PROXY, so this is applied per-request through a host allowlist
# (see src/server/outbound-proxy.ts). CRM (127.0.0.1) and self-hosted AI endpoints stay direct.
# META_PROXY_URL=http://127.0.0.1:7897

# Production uses https://graph.facebook.com by default. Override only for an approved local mock/test endpoint.
# META_GRAPH_BASE_URL=http://127.0.0.1:3999

# Auto-reply catch-up sweep: every owner is re-scanned once a minute so an inbound event
# lost to a restart still gets answered. Defaults to on outside the test environment.
# AUTO_CHAT_SWEEP=true

# Auto-reply generation engine. Default is the local WorkBuddy CLI (CodeBuddy), which needs no
# API key: the plugin spawns the CLI per reply and reads its stream-json output.
# GOODJOB_WORKBUDDY_BIN=/opt/homebrew/bin/codebuddy   # 空值 = 自动解析（独立版优先，桌面内置版兜底）
# GOODJOB_CLI_TIMEOUT_SECONDS=90                       # 单次生成超时
# GOODJOB_CLI_WORKSPACE=                               # 空值 = <cwd>/.data/cli-workspace（刻意用空目录，
#                                                      #   避免 CLI 把插件目录当仓库去探索）
# Skill directories the CLI scans. Leave empty: the plugin ships its own auto-reply skill at
# <plugin>/skills/goodjob-auto-reply/SKILL.md and injects it as CODEBUDDY_SESSION_SKILL_DIRS,
# so nothing needs installing. Set this only to point at a shared/installed location instead
# (same variable name as the Runner side, so one setting covers both).
# GOODJOB_SKILLS_DIRS=/path/to/skills
