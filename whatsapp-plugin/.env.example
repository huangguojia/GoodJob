# Development is the server default. Set NODE_ENV=production only in the production runtime.
# NODE_ENV=production
HOST=127.0.0.1
PORT=3100
WEB_ORIGIN=http://127.0.0.1:5173

# Must match the CRM backend JWT_SECRET. Plugin APIs and realtime sockets reject
# requests without a valid signed CRM session.
CRM_JWT_SECRET=

# Local development defaults to embedded PGlite. Production uses PostgreSQL.
DATABASE_CLIENT=pglite
PGLITE_PATH=.data/pgdata
MEDIA_STORAGE_PATH=.data/media
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_crm

# In production this must be a base64-encoded 32-byte key.
# Development creates a gitignored key under .data when this is empty.
SESSION_MASTER_KEY=

# Demo records and the simulated transport are opt-in, even in development.
# Never enable either setting in a production runtime.
SEED_DEMO=false
ALLOW_DEMO_PROVIDER=false
# Development convenience only. Production requires false and a separate `npm run db:migrate` release step.
AUTO_MIGRATE=true
ALLOW_PRIVATE_AI_ENDPOINTS=false

# Optional HTTP(S) CONNECT proxy used only by Baileys WhatsApp traffic.
# BAILEYS_PROXY_URL=http://127.0.0.1:7897

# Production uses https://graph.facebook.com by default. Override only for an approved local mock/test endpoint.
# META_GRAPH_BASE_URL=http://127.0.0.1:3999
