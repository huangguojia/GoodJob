# GoodJob CRM 宝塔部署配置
# 复制为 deploy.conf 后修改。不要把填写密码后的 deploy.conf 提交到 SVN。
# 数据库要求：MySQL 8.0+，不支持 MariaDB 10.x。
# WhatsApp 生产数据库要求：PostgreSQL 14+，安装器会自动创建独立数据库和用户。

# 必填：宝塔网站绑定的主域名，只能填写小写纯域名。
# 正确：www.youwilldoagoodjob.top
# 错误：https://www.youwilldoagoodjob.top、www.youwilldoagoodjob.top/、**www.youwilldoagoodjob.top**
# 脚本会核对宝塔 server_name、DNS、SSL 协议和运行时 Nginx 配置，避免 .com/.top 写错。
DOMAIN=crm.example.com

# 数据库会由脚本自动创建；如果服务器 MySQL root 账号需要密码，请填写 MYSQL_ROOT_PASSWORD。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=goodjob_crm
DB_USER=goodjob_crm
DB_PASSWORD='请替换为业务数据库密码'
MYSQL_ROOT_PASSWORD=''

# 纯终端模式：自动创建 MySQL 数据库、用户和 Nginx 网站配置。
AUTO_CREATE_DATABASE=true
AUTO_CREATE_SITE=true

# 主域名的 CORS_ORIGINS 和 Communication 的 WEB_ORIGIN 由脚本按 DOMAIN 与 SSL 自动生成，禁止手改服务器 .env。
# 可选：额外允许访问系统的完整来源。多个来源使用英文逗号分隔。
# 示例：https://www.crm.example.com,https://crm-backup.example.com
EXTRA_ALLOWED_ORIGINS=

# Swagger 是否启用。接口文档仍要求登录并具备管理员权限。
ENABLE_API_DOCS=true

# 系统设置中的 MySQL 文件迁移授权码。留空时安装器自动生成，升级时自动沿用。
# 原始 SQL 文件只在浏览器本地解析，不会上传或保存在服务器。
MYSQL_DATA_IMPORT_TOKEN=

# 是否允许 CRM 将数据库备份写入服务器磁盘。磁盘较小的宝塔服务器保持 false。
MYSQL_LOCAL_BACKUP_ENABLED=false
# 仅开启备份时使用。建议放在 shared 目录，升级版本时不会丢失。
MYSQL_LOCAL_BACKUP_DIR=/www/server/goodjob-crm/shared/database-backups
# 自动清理超过指定天数的备份；0 表示永久保留，不建议小磁盘服务器使用。
MYSQL_LOCAL_BACKUP_RETENTION_DAYS=7

# 后端只监听服务器本机，由宝塔 Nginx 代理，不需要开放此端口。
BACKEND_PORT=4188

# AI Agent 自动触发后台扫描周期，单位毫秒；通常保持 60000。
AGENT_TRIGGER_POLL_MS=60000

# 可选：分别指定 Agent 规划和结果核验使用的 AI 配置 ID 或模型名；留空时使用个人当前主模型。
AGENT_MODEL_ROUTE_PLANNING=
AGENT_MODEL_ROUTE_EVALUATION=

# Agent 模型费用保护。费用按 Token 估算，只用于限制和趋势，不是供应商实际账单。
AGENT_DAILY_BUDGET_USD=10
AGENT_MISSION_BUDGET_USD=2

# 每百万输入/输出 Token 的估算美元单价，请按实际模型价格调整。
AGENT_INPUT_USD_PER_MILLION_TOKENS=0.5
AGENT_OUTPUT_USD_PER_MILLION_TOKENS=1.5

# WhatsApp 插件后端端口，只监听服务器本机，不需要在安全组放行。
WHATSAPP_PLUGIN_PORT=3100

# WhatsApp PostgreSQL 配置。通常只需要安装 PostgreSQL，以下默认值即可。
WHATSAPP_DB_HOST=127.0.0.1
WHATSAPP_DB_PORT=5432
WHATSAPP_DB_NAME=goodjobcrm_whatsapp
WHATSAPP_DB_USER=goodjobcrm_whatsapp
WHATSAPP_DB_PASSWORD=
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# 首次安装空库时保持 false；升级现有系统时改为 true。
# 升级只读取现有 MySQL 结构并增量补齐，不导出、不压缩、不备份业务数据。
REUSE_EXISTING_DATABASE=false

# 兼容旧配置：必须保持 false。部署器不会备份或清空已有数据库。
REPLACE_DATABASE=false

# 网站目录已有自定义文件时才设置 true。
ALLOW_NONEMPTY_WEB_ROOT=false

# 默认自动补齐 40 个隔离团队管理员；账号密码写入服务器受限凭据文件。
PROVISION_BETA_ADMINS=true
# 40 个团队管理员全部核验成功后，删除旧通用管理员 admin@goodjob.com。
REMOVE_PRIMARY_ADMIN=true
# 可选：自定义 40 个管理员凭据文件路径，必须位于服务器受限目录。
BETA_ADMIN_CREDENTIALS_FILE=/www/server/goodjob-crm/shared/beta-admin-credentials.txt

# 使用此配置文件执行时保持 true，不再进行交互提问。
NON_INTERACTIVE=true

# 一般不需要修改。
APP_ROOT=/www/server/goodjob-crm
APP_USER=goodjob-crm
SERVICE_NAME=goodjob-crm

# WhatsApp 插件服务名，一般不需要修改。
WHATSAPP_PLUGIN_SERVICE_NAME=goodjob-crm-whatsapp
