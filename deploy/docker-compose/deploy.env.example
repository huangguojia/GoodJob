# GoodJob Docker 部署公开配置。密码不写在这里。
COMPOSE_PROJECT_NAME=goodjobcrm
GOODJOB_SHARED_DIR=/opt/goodjobcrm/shared

# 宝塔中为 GoodJob 单独创建的网站域名，不含协议和路径。
DOMAIN=crm.example.com
# 当前没有 SSL 时先填 http；宝塔签发证书后改为 https 并重新部署。
PUBLIC_SCHEME=http
PUBLIC_ORIGIN=http://crm.example.com
SESSION_COOKIE_SECURE=false
GOODJOB_HTTP_PORT=4188

# 首次启动创建的超级管理员。密码由 configure.sh 单独写入 secret 文件。
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Super_Admin

# 仅存在于 GoodJob 私有 Docker 网络，不映射宿主机端口。
MYSQL_DATABASE=goodjob_crm_prod
MYSQL_USER=goodjob_crm_app

ENABLE_API_DOCS=true
# 每次升级会先生成完整备份；默认保留最近 10 份，至少应保留 2 份。
GOODJOB_BACKUP_RETENTION_COUNT=10
# 宝塔 HTTPS 生效后填写 https://crm.example.com；HTTP 阶段留空，避免不安全追踪地址。
EMAIL_TRACKING_BASE_URL=

# 适合 8GB 服务器的初始资源上限，可在观察实际使用量后调整。
MYSQL_MEMORY_LIMIT=640m
MYSQL_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=640m
BACKEND_CPU_LIMIT=1.5
COMMUNICATION_MEMORY_LIMIT=384m
COMMUNICATION_CPU_LIMIT=1.0
